# Sayt sozlamalari — shu faylni ".env" nomi bilan nusxalab, qiymatlarni o'zgartiring.
# Domeningiz (DNS'da A yozuvi shu serverning IP manziliga qaragan bo'lsin)
DOMAIN=studio.example.uz
# Admin (foydalanuvchilarni ko'radi, o'chiradi/yoqadi)
ADMIN_EMAIL=siz@example.com
# Taklif kodi: bo'sh qolsa, har kim ro'yxatdan o'ta oladi. Boshida yopiq sinov uchun kod qo'ying.
INVITE_CODE=bir-maxfiy-kod
# 0 — ro'yxatdan o'tish yopiq (faqat mavjud foydalanuvchilar)
ALLOW_SIGNUP=1
# Foydalanuvchilar soniga chegara (0 — cheksiz)
MAX_USERS=20
TZ=Asia/Tashkent
